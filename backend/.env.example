# Optional: enables Gemini-generated blueprints. Without it, the app falls
# back to a simple template-based blueprint -- nothing breaks either way.
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Set this to your Vercel URL(s) once deployed, e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Leave unset (or "*") for local development.
ALLOWED_ORIGINS=*
